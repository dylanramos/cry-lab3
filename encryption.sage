from Crypto.Random import get_random_bytes
from Crypto.Signature.pss import MGF1
from Crypto.Hash import SHA256
from Crypto.Util.strxor import strxor
from Crypto.Util.Padding import pad, unpad


BIT_LEN_PRIME = 1024#2048
BYTE_LEN_RANDOMNESS = 128
REDUNDANCY = 10


def keyGen():
    p = 1
    while p %4 != 3: 
        p = random_prime(2**BIT_LEN_PRIME, proof = False, lbound = 2**(BIT_LEN_PRIME-1)) #proof = False for performances
    q = 1
    while q % 4 != 3: 
        q = random_prime(2**BIT_LEN_PRIME, proof = False, lbound = 2**(BIT_LEN_PRIME-1)) #proof = False for performances
    return (p, q, p*q)


def mgf(seed, length):
    #This function is correct and you don't need to look at it
    #It generates a mask of given length using the seed as input
    return MGF1(seed, length, SHA256)

def encrypt(m, n):
    BYTE_LEN_MESSAGE_PART = int(log(n,2))//8 - BYTE_LEN_RANDOMNESS
    if len(m) > BYTE_LEN_MESSAGE_PART - REDUNDANCY - 1 :
        raise Exception("Message too long. Maximum " + str(BYTE_LEN_MESSAGE_PART - REDUNDANCY - 1) + " bytes")
    m = pad(m, BYTE_LEN_MESSAGE_PART, style = 'iso7816')
    r = get_random_bytes(BYTE_LEN_RANDOMNESS)
    h = mgf(r, BYTE_LEN_MESSAGE_PART)
    m = strxor(m, h) + r
    return (int.from_bytes(m, 'little')**2) % n

def decrypt(c, p, q):
    BYTE_LEN_MESSAGE_PART = int(log(p*q,2))//8 - BYTE_LEN_RANDOMNESS

    P = Integers(p)
    Q = Integers(q)
    cp = P(c)
    cq = Q(c)
    roots_p = cp.sqrt(all=True)
    roots_q = cq.sqrt(all=True)

    for root_p in roots_p:
        for root_q in roots_q:
            root = crt(root_p.lift(), root_q.lift(), p, q)
            bytes_length = (root.nbits() + 7) // 8
            root_bytes = root.to_bytes(bytes_length, 'little')
            
            r = root_bytes[-BYTE_LEN_RANDOMNESS:]
            m_xor_h = root_bytes[:-BYTE_LEN_RANDOMNESS]
            h = mgf(r, BYTE_LEN_MESSAGE_PART)

            if len(m_xor_h) == BYTE_LEN_MESSAGE_PART:
                m_with_padding = strxor(m_xor_h, h)
                m = unpad(m_with_padding, BYTE_LEN_MESSAGE_PART, style = 'iso7816')
                return m

def test_decryption():
    print("-----Test 1-----")
    message = b"Hello, this is a test message for encryption."
    p, q, n = keyGen()
    c = encrypt(message, n)
    decrypted_message = decrypt(c, p, q)
    print("Original message :", message.decode())
    print("Decrypted message:", decrypted_message.decode())

    print("-----Test 2-----")
    message = b"Another test message for encryption."
    p, q, n = keyGen()
    c = encrypt(message, n)
    decrypted_message = decrypt(c, p, q)
    print("Original message :", message.decode())
    print("Decrypted message:", decrypted_message.decode())

    print("-----Test 3-----")
    message = b"Short message for encryption."
    p, q, n = keyGen()
    c = encrypt(message, n)
    decrypted_message = decrypt(c, p, q)
    print("Original message :", message.decode())
    print("Decrypted message:", decrypted_message.decode())

